# Stage to obtain required shared libraries (libz) for GraalVM runtime
FROM debian:12-slim AS libz

# Minimal Distroless image with glibc and nonroot user (UID 65532)
FROM gcr.io/distroless/base-debian12:nonroot

WORKDIR /app

# Copy libz shared library required by GraalVM native binary
COPY --from=libz /usr/lib/x86_64-linux-gnu/libz.so.1* /lib/x86_64-linux-gnu/
COPY --from=libz /usr/lib/x86_64-linux-gnu/libz.so.1* /usr/lib/x86_64-linux-gnu/

# Copy the compiled GraalVM native binary from application target
COPY --chown=nonroot:nonroot application/target/api-garage api-garage

USER nonroot:nonroot

EXPOSE 8080

ENTRYPOINT ["/app/api-garage"]